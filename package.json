{
  "name": "taskprox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project taskprox-rules-test \"vitest run -c vitest.rules.config.mts\"",
    "build:e2e": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1 NEXT_PUBLIC_FIREBASE_PROJECT_ID=taskprox-e2e next build",
    "test:e2e": "npm run build:e2e && firebase emulators:exec --only auth,firestore,storage --project taskprox-e2e \"playwright test\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:rules && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "firebase": "^11.10.0",
    "lucide-react": "^0.525.0",
    "motion": "^12.43.0",
    "next": "15.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.5",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.35.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
